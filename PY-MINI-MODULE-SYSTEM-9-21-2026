    """)
    choice = safe_input("Enter your choice: ") .strip()

    if choice  == '1':
        x = get_float("Enter a decimal number x: ")
        print(f"\n ceil({x}) = {math.ceil(x)}")
        print(f" floor({x}) = {math.floor} ")
        print(f" trunc({x}) = {math.trunc(x)}")

    elif choice == '2':
        n = get_float("Enter a non-negative whole number: ")
        try:
            print(f"\n {n}! = {math.factorial(n)}")
        except ValueError:
